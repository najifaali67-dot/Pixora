# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Authentication & PostgreSQL Database (Optional for remote persistent DB)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Bangladesh Payment Gateways (bKash, Nagad, SSLCommerz)
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_secret"
BKASH_USERNAME="your_merchant_username"
BKASH_PASSWORD="your_merchant_password"

NAGAD_MERCHANT_ID="your_nagad_merchant_id"
NAGAD_PUBLIC_KEY="your_nagad_public_key"
NAGAD_PRIVATE_KEY="your_nagad_private_key"

SSLCOMMERZ_STORE_ID="your_sslcz_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_sslcz_password"
SSLCOMMERZ_IS_LIVE="false"
